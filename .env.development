# Committed: no secrets here. Vite reads .env.development, .env.staging (--mode staging) and
# .env.production. Only VITE_* values reach the browser.

# Where the API and the apps are reached from the browser: the local gateway.
VITE_API_ORIGIN=http://localhost:8080
# Where the apps' remote entries are listed. Served by the gateway (likho-infra nginx/mfe).
VITE_MFE_MANIFEST=/mfe/manifest.json
